# NEXUS 통합 환경 설정 예시. 실제 값은 ./scripts/up.sh 가 .env 를 만들면서 이 노트북에서 무작위로 채웁니다.
# 직접 채울 것은 GROQ_API_KEY, DISCORD_WEBHOOK_URL 두 개뿐입니다(둘 다 선택). .env 는 절대 커밋하지 마세요.

MYSQL_ROOT_PASSWORD=
NEXUS_APP_PASSWORD=
NEXUS_CONF_PASSWORD=
NEXUS_N8N_LOCAL_DB_PASSWORD=
SECRET_KEY=
SEED_KIM_PW=
SEED_LEE_PW=
SEED_ADMIN_PW=
LAB_INTERNAL_API_TOKEN=
LAB_INTERNAL_API_FLAG=
# 선택. https://console.groq.com 에서 무료 발급. 비워 두면 AI 판정(R3·R11·R12, AI-XDR 평가)이 내장 판정으로 동작
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER=auto
XDR_AI_PROVIDER=auto
# demo = 관리자가 승인하면 실제로 IP 차단 / safe = 기록만(dry-run)
NEXUS_XDR_MODE=demo
GRAYLOG_ROOT_PASSWORD=
GRAYLOG_PASSWORD_SECRET=
N8N_ENCRYPTION_KEY=
N8N_OWNER_EMAIL=admin@nexus.local
N8N_OWNER_PASSWORD=
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_HEADER=x-webhook-token
# 선택. Discord 채널 > 연동 > 웹후크에서 만든 주소. 비워 두면 Discord 알림만 꺼짐(나머지는 정상)
DISCORD_WEBHOOK_URL=
XDR_RESPONSE_MODE=
XDR_IP_BLOCK_ENABLED=
GRAYLOG_ROOT_PASSWORD_SHA2=
# 1(기본) = n8n 자동 조치 노드 켬 / 0 = 끔
N8N_AUTO_ACTIONS=1
