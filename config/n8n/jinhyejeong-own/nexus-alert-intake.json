        "options": {}
      },
      "id": "a1f0c0de-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "a1f0c0de-0001-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.headers['x-webhook-token'] }}",
              "rightValue": "={{ $env.WEBHOOK_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c0de-0002-4000-8000-000000000002",
      "name": "토큰 확인",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst plan = {\n  R1: { actions: ['계정 잠금', 'Discord 알림', '티켓 생성'], ticket: '차단 조치' },\n  R2: { actions: ['Discord 알림', '티켓 생성'], ticket: '이상 징후 경보' },\n  R3: { actions: ['세션 종료', 'AI Tool 제한', 'Discord 알림', '티켓 생성'], ticket: '침해 인시던트' },\n  R4: { actions: ['내부 API 토큰 폐기', 'Discord 알림', '티켓 생성'], ticket: '침해 인시던트' },\n}[b.rule_id] || { actions: ['Discord 알림'], ticket: '이상 징후 경보' };\nconst message = `[${b.rule_id}] ${b.rule_name} | 출발지 ${b.src_ip} | 계정 ${b.user || '-'} | ${b.count}건 | 대응 예정: ${plan.actions.join(', ')}`;\nreturn [{ json: {\n  rule_id: b.rule_id, rule_name: b.rule_name, severity: b.severity,\n  src_ip: b.src_ip, user: b.user || '', count: b.count,\n  first_seen: b.first_seen, last_seen: b.last_seen,\n  graylog_event_id: b.graylog_event_id || '',\n  ticket_type: plan.ticket, ticket_key: b.src_ip,\n  actions: plan.actions, message,\n  discord_enabled: !!$env.DISCORD_WEBHOOK_URL,\n} }];"
      },
      "id": "a1f0c0de-0003-4000-8000-000000000003",
      "name": "정규화·대응 계획",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.discord_enabled }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c0de-0004-4000-8000-000000000004",
      "name": "Discord 설정됨?",
